<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/surface">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <include layout="@layout/uth_marca" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/resultado_titulo" android:textSize="32sp" android:textColor="@color/ink" android:textStyle="bold" android:gravity="center" android:layout_marginBottom="24dp" /><com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="24dp" app:cardBackgroundColor="@color/white" app:strokeWidth="0dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/suma" android:textSize="20sp" android:textColor="@color/ink" android:id="@+id/nombre_operacion" android:textStyle="bold" android:gravity="center" /><TextView android:id="@+id/expresion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textSize="22sp" android:gravity="center" android:textColor="@color/muted" android:textIsSelectable="true" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/resultado_etiqueta" android:textSize="12sp" android:textColor="@color/ink" android:layout_marginTop="28dp" android:gravity="center" /><TextView android:id="@+id/resultado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="40sp" android:textStyle="bold" android:gravity="center" android:textColor="@color/uth_green" android:textIsSelectable="true" android:accessibilityLiveRegion="polite" />
</LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.button.MaterialButton android:id="@+id/volver" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="28dp" android:text="@string/volver" app:cornerRadius="16dp" />    </LinearLayout>
</ScrollView>
