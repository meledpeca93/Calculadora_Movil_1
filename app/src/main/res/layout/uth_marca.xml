<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center" android:orientation="vertical" android:paddingBottom="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="UTH" android:textSize="48sp" android:textStyle="bold"
        android:letterSpacing="0.06" android:textColor="@color/uth_green"
        android:contentDescription="@string/marca_descripcion" />
    <View android:layout_width="48dp" android:layout_height="3dp" android:background="@color/uth_gold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="@string/institucion"
        android:gravity="center" android:textSize="12sp" android:textColor="@color/muted" />
</LinearLayout>
